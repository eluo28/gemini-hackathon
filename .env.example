# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional model override for frame-based product detection.
GEMINI_ITEM_MODEL="gemini-4-hydrogen"

# Optional JSON array of RTCIceServer objects (e.g. TURN servers for production NAT traversal).
# WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]'

# Optional local media binary paths (defaults resolve from PATH).
# FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# FFPROBE_PATH="/opt/homebrew/bin/ffprobe"

# Briefing, editing, and optional review use the same Gemini API key.
# These and GEMINI_ITEM_MODEL accept only Gemini 4 models; no Flash fallback.
GEMINI_CLIP_BRIEF_MODEL="gemini-4-hydrogen"
GEMINI_CLIP_EDITOR_MODEL="gemini-4-neon"
GEMINI_CLIP_REVIEW_MODEL="gemini-4-hydrogen"

# Local clip traces: JSON lines to stdout and a gitignored file; disabled by default.
# CLIP_TELEMETRY=1
# CLIP_TELEMETRY_FILE=".data/telemetry/clips.jsonl"
# Separate Vite hot-reload port when running another dev server alongside this one.
# VITE_HMR_PORT=24679
